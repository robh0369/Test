{
  "expo": {
    "name": "Hart Garden",
    "slug": "hart-garden",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#0e0f0c"
    },
